<main class="order-confirmation-main">

  <div class="order-container shadow p-4 rounded bg-white">
    <h2 class="text-center mb-4">Thank you for your order!</h2>

    <p class="text-center">Your Order ID is: <strong><%= order._id %></strong></p>

    <div class="customer-info mt-3">
      <h5>Customer Information</h5>
      <p><strong>Name:</strong> <%= order.customerName %></p>
      <p><strong>Email:</strong> <%= order.email %></p>
      <p><strong>Status:</strong> <%= order.status %></p>
      <p><strong>Placed on:</strong> <%= order.createdAt.toLocaleString() %></p>
    </div>

    <div class="order-items mt-4">
      <h5>Order Items</h5>
      <ul class="list-group">
        <% order.items.forEach(item => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= item.name %> x <%= item.quantity %>
            <span>$<%= item.price * item.quantity %></span>
          </li>
        <% }) %>
      </ul>
      <h5 class="mt-3 text-end">Total: $<%= order.totalAmount %></h5>
    </div>

    <div class="text-center mt-4">
      <a href="/products" class="btn btn-success">Continue Shopping</a>
    </div>
  </div>

</main>

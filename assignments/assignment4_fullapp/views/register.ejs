

<div class="register-page d-flex justify-content-center align-items-center min-vh-100">
  <div class="register-box" style="max-width:400px; width:100%;">
    <h2 class="register-title text-center mb-4">Register</h2>

    <form action="/auth/register" method="POST">
      <input type="text" name="name" class="form-control register-input mb-3" placeholder="Name" required>
      <input type="email" name="email" class="form-control register-input mb-3" placeholder="Email" required>
      <input type="password" name="password" class="form-control register-input mb-3" placeholder="Password" required>
      <button class="btn register-btn w-100">Register</button>
    </form>
  </div>
</div>

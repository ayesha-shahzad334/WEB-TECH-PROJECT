
<div >

<h1>Edit Product</h1>
<form action="/admin/products/edit/<%= taxi._id %>" method="POST">
  <div class="mb-3">
    <label>Name</label>
    <input type="text" name="name" class="form-control" value="<%= taxi.name %>" required>
  </div>
<div class="mb-3">
  <label>Category</label>
  <select name="category" class="form-select">
    <option value="Premium" <%= taxi && taxi.category === 'Premium' ? 'selected' : '' %>>Premium</option>
    <option value="Economy" <%= taxi && taxi.category === 'Economy' ? 'selected' : '' %>>Economy</option>
    <option value="Comfort" <%= taxi && taxi.category === 'Comfort' ? 'selected' : '' %>>Comfort</option>
  </select>
</div>

  <div class="mb-3">
    <label>Price</label>
    <input type="number" name="price" class="form-control" value="<%= taxi.price %>" required>
  </div>
  <div class="mb-3">
    <label>Description</label>
    <textarea name="description" class="form-control"><%= taxi.description %></textarea>
  </div>
  <div class="mb-3">
    <label>Image URL</label>
    <input type="text" name="image" class="form-control" value="<%= taxi.image %>">
  </div>
  <button type="submit" class="btn btn-primary">Update Product</button>
</form>

</div>



<div>
<h1>Products</h1>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Category</th>
      <th>Price</th>
      <th>Description</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% taxis.forEach(taxi => { %>
      <tr>
        <td><%= taxi.name %></td>
        <td><%= taxi.category %></td>
        <td>$<%= taxi.price %></td>
        <td><%= taxi.description %></td>
        <td>
          <a href="/admin/products/edit/<%= taxi._id %>" class="btn btn-sm btn-primary">Edit</a>
          <form action="/admin/products/delete/<%= taxi._id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<div>

<h1 class="mb-4">Dashboard</h1>

<div class="row g-4">

  <div class="col-md-3">
    <div class="card text-center bg-warning text-dark shadow">
      <div class="card-body">
        <h5 class="card-title">Total Products</h5>
        <p class="card-text fs-3"><%= stats.totalProducts %></p>
        <a href="/admin/products" class="btn btn-dark btn-sm">View Products</a>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-center bg-info text-dark shadow">
      <div class="card-body">
        <h5 class="card-title">Premium Products</h5>
        <p class="card-text fs-3"><%= stats.premiumProducts %></p>
        <a href="/admin/products?category=Premium" class="btn btn-dark btn-sm">View</a>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-center bg-success text-dark shadow">
      <div class="card-body">
        <h5 class="card-title">Economy Products</h5>
        <p class="card-text fs-3"><%= stats.economyProducts %></p>
        <a href="/admin/products?category=Economy" class="btn btn-dark btn-sm">View</a>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-center bg-secondary text-dark shadow">
      <div class="card-body">
        <h5 class="card-title">Comfort Products</h5>
        <p class="card-text fs-3"><%= stats.comfortProducts %></p>
        <a href="/admin/products?category=Comfort" class="btn btn-dark btn-sm">View</a>
      </div>
    </div>
  </div>

</div>
</div>
